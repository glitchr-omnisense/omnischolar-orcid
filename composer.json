{
    "name": "omnischolar/orcid",
    "type": "library",
    "description": "Omnischolar ORCID: a researcher's identity, CV (employments, education, distinctions...) and declared works, through ORCID's public API - no key.",
    "keywords": [
        "scholarly",
        "publications",
        "orcid",
        "cv",
        "researcher",
        "omnischolar"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnischolar": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnischolar\\Orcid\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnischolar\\Orcid\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
